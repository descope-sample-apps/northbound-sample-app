# Copy to .env.local for local development. Never commit a filled-in .env.
# Every value here has a working default — the app runs with no .env.local at all.

# Local SQLite file. Point at a hosted libsql URL (libsql://...) for a
# persistent hosted demo: Vercel's filesystem is ephemeral and will not retain
# writes. Changing this needs no code edits.
DATABASE_URL="file:./data/northbound.db"

# Shared secret the storefront uses to authenticate itself to the simulated
# legacy auth backend. Server-to-server only; never sent to a browser, and
# never reachable by an OAuth client or an agent.
LEGACY_AUTH_SERVICE_TOKEN="dev-only-legacy-token"

# OPTIONAL — turns the legacy credential check into a real HTTP hop.
#
# Unset (the default), lib/auth/verify.ts calls the /legacy-auth/verify handler
# in process, so the app runs as a single service with nothing to start.
# Set, the same check goes over the network, which is what makes the boundary
# visible on a request trace — useful when demonstrating that the credential
# travels server-to-server and never touches the client.
#
# Setting this REQUIRES LEGACY_AUTH_SERVICE_TOKEN above; the app refuses to
# start otherwise rather than silently rejecting every legacy login as a wrong
# password.
#
# LEGACY_AUTH_URL="http://localhost:3000/legacy-auth/verify"
