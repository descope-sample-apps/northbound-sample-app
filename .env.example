# Copy to .env.local for local development. Never commit a filled-in .env.

# Local SQLite file. Point at a Turso URL (libsql://...) for a persistent
# hosted demo — Vercel's filesystem is ephemeral and will not retain writes.
DATABASE_URL="file:./data/northbound.db"

# Shared secret the storefront uses to call the simulated legacy auth backend
# at /legacy-auth/verify. Server-to-server only; this value is never sent to a
# browser and never reaches an OAuth client or agent.
LEGACY_AUTH_SERVICE_TOKEN="dev-only-legacy-token"
