# Copy to .env.local for local development. Never commit a filled-in .env.
# Every value here has a working default — the app runs with no .env.local at all.

# Local SQLite file. Point at a hosted libsql URL (libsql://...) for a
# persistent hosted demo: Vercel's filesystem is ephemeral and will not retain
# writes. Changing this needs no code edits.
DATABASE_URL="file:./data/northbound.db"

# Shared secret the storefront uses to authenticate itself to the simulated
# legacy auth backend. Server-to-server only; never sent to a browser, and
# never reachable by an OAuth client or an agent.
LEGACY_AUTH_SERVICE_TOKEN="dev-only-legacy-token"

# OPTIONAL — turns the legacy credential check into a real HTTP hop.
#
# Unset (the default), lib/auth/verify.ts calls the /legacy-auth/verify handler
# in process, so the app runs as a single service with nothing to start.
# Set, the same check goes over the network, which is what makes the boundary
# visible on a request trace — useful when demonstrating that the credential
# travels server-to-server and never touches the client.
#
# Setting this REQUIRES LEGACY_AUTH_SERVICE_TOKEN above; the app refuses to
# start otherwise rather than silently rejecting every legacy login as a wrong
# password.
#
# LEGACY_AUTH_URL="http://localhost:3000/legacy-auth/verify"

# OPTIONAL — the RS256 key used to sign access tokens.
#
# Unset, a key is generated into data/keys.json on first run, which is right for
# local development. REQUIRED for any host with an ephemeral filesystem (Vercel):
# without it each instance generates its own key and rejects tokens signed by the
# others. Generate one with `pnpm oauth:keygen`.
#
# NORTHBOUND_SIGNING_KEY='{"privateJwk":{...},"publicJwk":{...},"kid":"..."}'

# OPTIONAL — pins the issuer when a proxy rewrites Host. Otherwise the issuer is
# derived from the request, which is what makes `ngrok http 3000` work unchanged.
#
# NORTHBOUND_ISSUER="https://your-tunnel.ngrok.io"

# OPTIONAL — selects the Descope authorization server implementation. That
# implementation is a deliberate stub; setting this makes every OAuth endpoint
# throw with a TODO naming the Descope API a real one would call.
#
# DESCOPE_PROJECT_ID="P2..."

# OPTIONAL — Descope Inbound App clients, one per recognised agent platform.
#
# The client is what carries an agent's identity into a Descope policy, since
# policies key off client.tags. config/agent-platforms.json names which variable
# belongs to which platform; the IDs themselves are project configuration and are
# never committed.
#
# A platform with no client configured still keeps its tier — a missing variable
# is a configuration gap, not a trust decision, and must not be mistakable for a
# failed signature.
#
# DESCOPE_CLIENT_MUSE="..."
# DESCOPE_CLIENT_INSTINCT="..."
# DESCOPE_CLIENT_SHOPPING_ASSISTANT="..."
