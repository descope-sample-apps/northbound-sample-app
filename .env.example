# Copy to .env.local for local development. Never commit a filled-in .env.
# Every value here has a working default — the app runs with no .env.local at all.

# Local SQLite file. Point at a hosted libsql URL (libsql://...) for a
# persistent hosted demo: Vercel's filesystem is ephemeral and will not retain
# writes. Changing this needs no code edits.
DATABASE_URL="file:./data/northbound.db"

# Shared secret the storefront uses to authenticate itself to the simulated
# legacy auth backend. Server-to-server only; never sent to a browser, and
# never reachable by an OAuth client or an agent.
LEGACY_AUTH_SERVICE_TOKEN="dev-only-legacy-token"

# OPTIONAL — turns the legacy credential check into a real HTTP hop.
#
# Unset (the default), lib/auth/verify.ts calls the /legacy-auth/verify handler
# in process, so the app runs as a single service with nothing to start.
# Set, the same check goes over the network, which is what makes the boundary
# visible on a request trace — useful when demonstrating that the credential
# travels server-to-server and never touches the client.
#
# Setting this REQUIRES LEGACY_AUTH_SERVICE_TOKEN above; the app refuses to
# start otherwise rather than silently rejecting every legacy login as a wrong
# password.
#
# LEGACY_AUTH_URL="http://localhost:3000/legacy-auth/verify"

# --- AI agents, through Agent Edge (https://github.com/descope/agent-edge) ---
# Your Descope inbound app's Discovery URL. When set, a Descope access token in the
# agent's browser cookie signs the agent in as the customer with the same email.
# Unset, the storefront behaves exactly as before.
# DESCOPE_DISCOVERY_URL="https://api.descope.com/v1/apps/<project ID>/.well-known/openid-configuration"
# The Descope resource agents' tokens must be issued for (the token's aud), for example
# https://northbound.camp/agent_resource. Set it to the front door's RESOURCE.
# DESCOPE_AUDIENCE=""
# The cookie the Agent Edge front door sets. Defaults to DS.
# AGENT_SESSION_COOKIE="DS"
# Step-up: where to send an agent that needs the customer's approval to buy, and the secret
# shared with that front door for signing the order it shows the customer.
# FRONT_DOOR_URL="http://localhost:8788"
# STEP_UP_SECRET=""

# Demo only: create an account the first time someone approves an agent with an email
# Northbound hasn't seen (with a sample address and test card), so they need no sign-up.
# DEMO_AUTO_SIGNUP="true"

# Optional, not needed for agents: Descope External Authentication, so customers approve
# agents by signing in to Northbound itself instead of through Descope (email code or Google).
# Northbound then calls Descope's Management API to finish the flow.
# DESCOPE_PROJECT_ID=""
# DESCOPE_MANAGEMENT_KEY=""
